# Jira Cloud
JIRA_URL=https://example.atlassian.net
JIRA_EMAIL=user@example.com
JIRA_API_TOKEN=replace-me

# Default: assigned to current Jira user and unresolved.
JQL=assignee = currentUser() AND resolution = Unresolved ORDER BY updated DESC
POLL_INTERVAL=60
MAX_RESULTS=50

# Preferred Teams transport: Microsoft Teams Workflows webhook.
# v0.5 expects the Workflow trigger authentication setting to be "Anyone".
# Treat the callback URL as a secret.
TEAMS_TRANSPORT=webhook
TEAMS_WEBHOOK_URL=

# Legacy/experimental Teams Personal consumer transport:
# TEAMS_TRANSPORT=consumer
# TEAMS_THREAD_ID=19:...@thread.v2
# TEAMS_TO=Exact Display Name

# Optional paths.
# STATE_FILE=/home/user/.cache/jira2teams/state.json
# TEAMS_AUTH_FILE=/home/user/.config/jira2teams/teams-auth.json
